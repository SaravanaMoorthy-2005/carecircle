{
  "name": "carecircle",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "functions",
    "packages/shared"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @carecircle/web",
    "build": "npm run build --workspace @carecircle/web && npm run build --workspace @carecircle/functions",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:rules": "vitest run --project rules",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test --grep-invert @a11y",
    "test:a11y": "playwright test --grep @a11y",
    "test:emulated": "npm run test:rules && npm run test:integration && npm run test:e2e && npm run test:a11y",
    "emulators": "npm run build --workspace @carecircle/functions && firebase emulators:start --project demo-carecircle --only auth,firestore,functions",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run check:deployment && firebase emulators:exec --project demo-carecircle --only auth,firestore,functions \"npm run test:emulated\" && npm audit --omit=dev --audit-level=high",
    "demo:seed": "tsx scripts/seed.ts",
    "reminders:tick": "tsx scripts/tick.ts",
    "check:deployment": "node scripts/check-deployment.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.65.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "firebase-tools": "15.36.0",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "esbuild": "0.28.2"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7",
    "glob": "14.0.6",
    "minimatch": "11.0.8",
    "uuid": "11.1.1",
    "@google-cloud/pubsub": {
      "@opentelemetry/core": "2.8.0"
    }
  }
}
