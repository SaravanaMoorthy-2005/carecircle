{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "src",
        "node_modules",
        ".env*",
        "*.local",
        ".runtime",
        ".runtime/**",
        ".secret.local",
        "build.mjs"
      ],
      "predeploy": ["npm run build --workspace @carecircle/functions"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": false
  }
}
